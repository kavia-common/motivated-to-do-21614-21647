# Copy to .env and adjust values for your environment.
# Comma-separated list of allowed origins for CORS. Use explicit origins in production.
FRONTEND_ORIGINS=http://localhost:3000

# Supabase configuration (used when integrating full CRUD with Supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional: service role key if backend needs server-side access (do not expose to frontend!)
SUPABASE_SERVICE_ROLE_KEY=
